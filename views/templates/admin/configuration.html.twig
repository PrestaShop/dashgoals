{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
  <div class="row justify-content-center">
    <div class="col-xl-10">
      <div class="form-inline mb-3">
        <label class="mr-2">{{ 'Year'|trans({}, 'Modules.Dashgoals.Admin') }}</label>
        <div class="btn-group" role="group">
          {% for choice in range(year - 2, year + 2) %}
            <a href="{{ path('dashgoals_configuration', {year: choice}) }}" class="btn btn-outline-secondary{{ choice == year ? ' active' : '' }}">{{ choice }}</a>
          {% endfor %}
        </div>
      </div>

      {{ form_start(configurationForm) }}
        <div class="card">
          <h3 class="card-header">
            <i class="material-icons">settings</i>
            {{ 'Monthly goals settings'|trans({}, 'Modules.Dashgoals.Admin') }} — {{ year }}
          </h3>
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>{{ year }}</th>
                  <th>{{ 'Traffic'|trans({}, 'Modules.Dashgoals.Admin') }}</th>
                  <th>{{ 'Conversion Rate'|trans({}, 'Modules.Dashgoals.Admin') }}</th>
                  <th>{{ 'Average Cart Value'|trans({}, 'Modules.Dashgoals.Admin') }}</th>
                </tr>
              </thead>
              <tbody>
                {% for month, label in monthLabels %}
                  <tr>
                    <td>{{ label }}</td>
                    <td>{{ form_widget(attribute(configurationForm, 'traffic_' ~ month)) }}</td>
                    <td>{{ form_widget(attribute(configurationForm, 'conversion_' ~ month)) }}</td>
                    <td>{{ form_widget(attribute(configurationForm, 'avg_cart_value_' ~ month)) }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          <div class="card-footer">
            <div class="d-flex justify-content-end">
              <button class="btn btn-primary">{{ 'Save'|trans({}, 'Admin.Actions') }}</button>
            </div>
          </div>
        </div>
        {{ form_rest(configurationForm) }}
      {{ form_end(configurationForm, {render_rest: false}) }}
    </div>
  </div>
{% endblock %}
